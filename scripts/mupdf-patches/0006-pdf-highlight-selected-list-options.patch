+/* Match export values, using /I to distinguish options with identical values. */
+static int
+choice_option_selected(fz_context *ctx, pdf_obj *field, pdf_obj *option, int index)
+{
+	pdf_obj *indices = pdf_dict_get_inheritable(ctx, field, PDF_NAME(I));
+	pdf_obj *value = pdf_dict_get_inheritable(ctx, field, PDF_NAME(V));
+	int i;
+	if (pdf_is_array(ctx, indices))
+	{
+		for (i = 0; i < pdf_array_len(ctx, indices); ++i)
+			if (pdf_is_int(ctx, pdf_array_get(ctx, indices, i)) && pdf_array_get_int(ctx, indices, i) == index)
+				return 1;
+		return 0;
+	}
+	if (pdf_is_array(ctx, option))
+		option = pdf_array_get(ctx, option, 0);
+	if (!pdf_is_string(ctx, option))
+		return 0;
+	if (pdf_is_array(ctx, value))
+	{
+		for (i = 0; i < pdf_array_len(ctx, value); ++i)
+			if (pdf_is_string(ctx, pdf_array_get(ctx, value, i)) &&
+				!strcmp(pdf_to_text_string(ctx, option), pdf_array_get_text_string(ctx, value, i)))
+				return 1;
+		return 0;
+	}
+	return pdf_is_string(ctx, value) && !strcmp(pdf_to_text_string(ctx, option), pdf_to_text_string(ctx, value));
+}
+
+/* Each option is one clipped row. Its own resources retain fonts from other rows. */
+static void
+write_choice_row(fz_context *ctx, pdf_annot *annot, fz_buffer *buf, pdf_obj *xobjects,
+	const char *text, const char *font, float size, int n, float *color,
+	int q, float w, float h, float x, float y, int index)
+{
+	fz_buffer *row = fz_new_buffer(ctx, 256);
+	pdf_obj *res = NULL;
+	pdf_obj *appearance = NULL;
+	char name[40];
+	char *rc = NULL;
+	fz_var(res);
+	fz_var(appearance);
+	fz_var(rc);
+	fz_try(ctx)
+	{
+#if FZ_ENABLE_HTML_ENGINE
+		if (text_needs_rich_layout(ctx, text))
+		{
+			char css[400];
+			rc = escape_text(ctx, text);
+			fz_snprintf(css, sizeof css,
+				"font-family:%s;font-size:%gpt;color:#%06x;text-align:%s;white-space:pre",
+				full_font_name(&font), size, hex_from_color(ctx, n, color),
+				q == 0 ? "left" : q == 1 ? "center" : "right");
+			write_rich_content(ctx, annot, row, &res, rc, css, size, w, h, 0, 0);
+		}
+		else
+#endif
+			write_variable_text(ctx, annot, row, &res, pdf_annot_language(ctx, annot),
+				text, font, size, n, color, q, w, h, 0, 0.8f, 1.2f, 0, 0, 0);
+		appearance = pdf_new_xobject(ctx, annot->page->doc, fz_make_rect(0, 0, w, h), fz_identity, res, row);
+		fz_snprintf(name, sizeof name, "Opt%d", index);
+		pdf_dict_puts(ctx, xobjects, name, appearance);
+		fz_append_printf(ctx, buf, "q 1 0 0 1 %g %g cm /%s Do Q\n", x, y, name);
+	}
+	fz_always(ctx)
+	{
+		fz_free(ctx, rc);
+		pdf_drop_obj(ctx, appearance);
+		pdf_drop_obj(ctx, res);
+		fz_drop_buffer(ctx, row);
+	}
+	fz_catch(ctx)
+		fz_rethrow(ctx);
+}
