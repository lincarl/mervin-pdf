# Keep Linux/CI text assets LF so shell scripts and packaging metadata work on
# Linux regardless of a contributor's core.autocrlf setting. (Windows sources are
# fine either way and use the platform default.)
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.desktop       text eol=lf
*.metainfo.xml  text eol=lf
packaging/linux/postinst  text eol=lf
packaging/linux/postrm    text eol=lf
# Translation catalogs: lupdate rewrites them, so keep one line ending everywhere.
*.ts            text eol=lf
# MuPDF patches: git apply on Windows rejects CRLF copies against MuPDF's LF
# sources, and the build scripts and CI cache keys hash these files.
*.patch         text eol=lf

# Binary assets - never normalize.
*.png          binary
*.ico          binary
*.pdf          binary
*.traineddata  binary
