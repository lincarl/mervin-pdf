#!/bin/sh
# Locate the private runtime for both native packages and relocated AppImages.
set -eu
launcher=$(readlink -f -- "$0")
prefix=$(CDPATH='' cd -- "$(dirname -- "$launcher")/.." && pwd)
runtime="$prefix/@MERVIN_LINUX_RUNTIME_DIR@"
# A desktop session can export paths for a different Qt installation.
unset QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
exec "$runtime/bin/MervinPDF" "$@"
